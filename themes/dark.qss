/* WiFiNexus Guardian - Dark Theme */

QWidget { background-color: #121212; color: #FFFFFF; font-family: "Segoe UI"; }
QMainWindow { background-color: #121212; }
QPushButton { background-color: #1E1E1E; color: #2196F3; border: 1px solid #2196F3; border-radius: 4px; padding: 8px; }
QPushButton:hover { background-color: #2196F3; color: #FFFFFF; }
QLineEdit, QTextEdit { background-color: #1E1E1E; color: #FFFFFF; border: 1px solid #333333; border-radius: 3px; padding: 5px; }
QTabBar::tab:selected { background-color: #2196F3; color: #FFFFFF; }
QProgressBar { background-color: #1E1E1E; border: 1px solid #333333; }
QProgressBar::chunk { background-color: #2196F3; }
