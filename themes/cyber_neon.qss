/* WiFiNexus Guardian - Cyber Neon Theme */
/* Professional Security Edition v1.0.0 */

QWidget {
    background-color: #0A0A0A;
    color: #FFFFFF;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
}

QMainWindow {
    background-color: #0A0A0A;
}

QMenuBar {
    background-color: #1A1A1A;
    color: #00D9FF;
    padding: 5px;
}

QMenuBar::item:selected {
    background-color: #00D9FF;
    color: #0A0A0A;
}

QMenu {
    background-color: #1A1A1A;
    border: 1px solid #00D9FF;
}

QMenu::item:selected {
    background-color: #00D9FF;
    color: #0A0A0A;
}

QPushButton {
    background-color: #1A1A1A;
    color: #00D9FF;
    border: 2px solid #00D9FF;
    border-radius: 5px;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #00D9FF;
    color: #0A0A0A;
}

QPushButton:pressed {
    background-color: #00AAFF;
}

QPushButton:disabled {
    background-color: #333333;
    color: #666666;
    border-color: #666666;
}

QLineEdit {
    background-color: #1A1A1A;
    color: #00D9FF;
    border: 1px solid #00D9FF;
    border-radius: 3px;
    padding: 5px;
}

QLineEdit:focus {
    border: 2px solid #00FF88;
}

QTextEdit {
    background-color: #1A1A1A;
    color: #00D9FF;
    border: 1px solid #00D9FF;
    border-radius: 3px;
    padding: 5px;
}

QTabWidget::pane {
    border: 1px solid #00D9FF;
    background-color: #1A1A1A;
}

QTabBar::tab {
    background-color: #1A1A1A;
    color: #00D9FF;
    border: 1px solid #00D9FF;
    border-bottom: none;
    padding: 8px 16px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #00D9FF;
    color: #0A0A0A;
}

QTabBar::tab:hover:!selected {
    background-color: #00FF88;
    color: #0A0A0A;
}

QProgressBar {
    background-color: #1A1A1A;
    border: 1px solid #00D9FF;
    border-radius: 5px;
    height: 20px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #00D9FF, stop:1 #00FF88);
    border-radius: 3px;
}

QSlider::groove:horizontal {
    background-color: #1A1A1A;
    border: 1px solid #00D9FF;
    height: 8px;
    border-radius: 4px;
}

QSlider::handle:horizontal {
    background-color: #00D9FF;
    border: 2px solid #00FF88;
    width: 18px;
    margin: -6px 0;
    border-radius: 9px;
}

QComboBox {
    background-color: #1A1A1A;
    color: #00D9FF;
    border: 1px solid #00D9FF;
    border-radius: 3px;
    padding: 5px;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #1A1A1A;
    color: #00D9FF;
    border: 1px solid #00D9FF;
    selection-background-color: #00D9FF;
    selection-color: #0A0A0A;
}

QTableWidget {
    background-color: #1A1A1A;
    color: #00D9FF;
    border: 1px solid #00D9FF;
    gridline-color: #333333;
}

QTableWidget::item:selected {
    background-color: #00D9FF;
    color: #0A0A0A;
}

QHeaderView::section {
    background-color: #1A1A1A;
    color: #00D9FF;
    border: 1px solid #00D9FF;
    padding: 8px;
    font-weight: bold;
}

QScrollBar:vertical {
    background-color: #0A0A0A;
    width: 12px;
    border: 1px solid #00D9FF;
}

QScrollBar::handle:vertical {
    background-color: #00D9FF;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QGroupBox {
    border: 2px solid #00D9FF;
    border-radius: 5px;
    margin-top: 10px;
    padding-top: 10px;
    font-weight: bold;
    color: #00D9FF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

QLabel {
    color: #00D9FF;
}

QLabel#titleLabel {
    font-size: 14pt;
    font-weight: bold;
    color: #00FF88;
}

QLabel#warningLabel {
    color: #FFAA00;
}

QLabel#errorLabel {
    color: #FF4444;
}

QLabel#successLabel {
    color: #00FF88;
}

QToolTip {
    background-color: #1A1A1A;
    color: #00D9FF;
    border: 1px solid #00D9FF;
    padding: 5px;
}

QStatusBar {
    background-color: #1A1A1A;
    color: #00D9FF;
    border-top: 1px solid #00D9FF;
}

QSplitter::handle {
    background-color: #00D9FF;
    height: 2px;
}

QRadioButton {
    color: #00D9FF;
    spacing: 5px;
}

QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border: 2px solid #00D9FF;
    border-radius: 8px;
    background-color: #1A1A1A;
}

QRadioButton::indicator:checked {
    background-color: #00D9FF;
}

QCheckBox {
    color: #00D9FF;
    spacing: 5px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 2px solid #00D9FF;
    border-radius: 3px;
    background-color: #1A1A1A;
}

QCheckBox::indicator:checked {
    background-color: #00D9FF;
}

/* Custom Classes */
.QFrame#mainFrame {
    background-color: #0A0A0A;
    border: none;
}

.QFrame#contentFrame {
    background-color: #1A1A1A;
    border: 1px solid #00D9FF;
    border-radius: 5px;
}

.QFrame#headerFrame {
    background-color: #1A1A1A;
    border-bottom: 2px solid #00D9FF;
}

.QFrame#statusFrame {
    background-color: #1A1A1A;
    border-top: 1px solid #00D9FF;
}
